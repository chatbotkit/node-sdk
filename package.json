{
  "name": "@chatbotkit/monorepo",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=24.20.0",
    "pnpm": ">=11.24.0 <12.0.0"
  },
  "type": "module",
  "scripts": {
    "build": "run-s build:*",
    "build:all": "turbo run build",
    "check": "run-s check:*",
    "check:all": "turbo run check",
    "clean": "run-p clean:*",
    "clean:all": "turbo run clean",
    "format": "run-p format:*",
    "format:pkg": "format-package -w",
    "format:src": "prettier -w .",
    "lint": "run-s lint:*",
    "lint:all": "turbo run lint",
    "prepare-changes": "changeset",
    "publish-changes": "turbo run lint check build test && changeset version && changeset publish",
    "release": "turbo run lint check build test && changeset publish",
    "test": "turbo run test"
  },
  "dependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@changesets/cli": "^2.29.8",
    "@trivago/prettier-plugin-sort-imports": "^4.3.0",
    "@tsconfig/recommended": "^1.0.2",
    "@types/node": "^20.9.1",
    "@typescript-eslint/eslint-plugin": "^8.56.0",
    "@typescript-eslint/parser": "^8.56.0",
    "dotenv": "^16.4.5",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.1.8",
    "format-package": "^7.0.0",
    "npm-run-all2": "^9.0.3",
    "prettier": "^2.8.7",
    "rimraf": "^5.0.5",
    "turbo": "^2.3.3",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.9.0",
    "typedoc-plugin-mdn-links": "^5.0.10",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  }
}
